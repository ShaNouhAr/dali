# Base Kali Linux image
FROM kalilinux/kali-rolling

# Set environment to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Update system
RUN apt update && \
    apt -y upgrade && \
    apt -y autoremove

# Install essential tools only (faster build, ~5-10 min)
RUN apt update && \
    apt -y install \
    git \
    python3 \
    python3-pip \
    curl \
    wget \
    iputils-ping \
    traceroute \
    dnsutils \
    net-tools \
    iproute2 \
    telnet \
    bind9-dnsutils \
    nmap \
    masscan \
    netcat-traditional \
    nikto \
    dirb \
    sqlmap \
    metasploit-framework \
    exploitdb \
    hydra \
    john \
    hashcat \
    aircrack-ng \
    wireshark \
    tcpdump \
    gobuster \
    wfuzz \
    ffuf \
    wordlists \
    seclists \
    burpsuite \
    zaproxy \
    && apt clean && \
    rm -rf /var/lib/apt/lists/*

# Install dirsearch
RUN git clone https://github.com/maurosoria/dirsearch.git /opt/dirsearch && \
    chmod +x /opt/dirsearch/dirsearch.py && \
    ln -s /opt/dirsearch/dirsearch.py /usr/local/bin/dirsearch

# Create data folder
RUN mkdir -p /data

# Set working directory
WORKDIR /root

# Default command
CMD ["/bin/bash"]

